{
  "name": "@banksia/domain-objects",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.0",
  "description": "Enterprise-grade Domain-Driven Design (DDD) primitives and building blocks for TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench",
    "build": "rslib build",
    "check:exports": "publint && attw --pack .",
    "dev": "rslib build --watch",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "format": "prettier --write .",
    "lint": "prettier --check \"src/**/*\" \"tests/**/*\" README.md",
    "size": "size-limit",
    "test": "vitest run",
    "release": "pnpm run build && changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Banksia-Corp/domain-objects.git"
  },
  "bugs": {
    "url": "https://github.com/Banksia-Corp/domain-objects/issues"
  },
  "homepage": "https://github.com/Banksia-Corp/domain-objects#readme",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^2.27.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@rslib/core": "^0.23.2",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.2.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
